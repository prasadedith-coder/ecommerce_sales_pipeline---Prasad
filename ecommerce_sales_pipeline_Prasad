1. Raw tables
Bronze layer: read each source file, save it as a table. The values stay exactly as they came in - the only touches are a blank-row guard and snake_casing the headers, because delta won't accept the spacey source column names.
# customers arrive as an excel dump. there's no native spark excel reader, so
# we go through read_files which handles the sheet just fine. values stay
# exactly as they came in, but delta won't accept the spacey source headers,
# so the column names get snake_cased here
CUSTOMER_RENAMES = {
    "Customer ID": "customer_id",
    "Customer Name": "customer_name",
    "email": "email",
    "phone": "phone",
    "address": "address",
    "Segment": "segment",
    "Country": "country",
    "City": "city",
    "State": "state",
    "Postal Code": "postal_code",
    "Region": "region",
}

raw_customers = spark.sql(f"""
    SELECT * FROM read_files('{DATA_DIR}/Customer.xlsx',
        format => 'excel',
        headerRows => 1,
        schemaEvolutionMode => 'none')
""")

for old, new in CUSTOMER_RENAMES.items():
    raw_customers = raw_customers.withColumnRenamed(old, new)

# the sheet's used range runs past the real data, so drop rows where the
# id column is blank
raw_customers = raw_customers.where(
    F.col("customer_id").isNotNull() & (F.trim(F.col("customer_id")) != "")
)

raw_customers.write.mode("overwrite").saveAsTable(f"{SCHEMA}.raw_customers")
print(f"raw_customers: {raw_customers.count()} rows")

