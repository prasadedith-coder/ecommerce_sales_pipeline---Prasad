3. Enriched orders (the fact table)
Orders plus customer info (name, country) plus product info (category, sub-category), profit rounded to 2 decimals.

All joins are left joins so no revenue silently disappears, and date parsing goes through try_to_date - a value that doesn't parse becomes a null we can count and complain about, instead of a dead job.


# dates in the json are day-first ('21/8/2016' = 21 Aug 2016) - parse with
# 'd/M/yyyy'. try_to_date returns null instead of throwing, so unparseable
# values show up in the assert below instead of killing the run
orders_clean = (
    raw_orders
    .withColumn("order_date", F.expr("try_to_date(order_date, 'd/M/yyyy')"))
    .withColumn("ship_date", F.expr("try_to_date(ship_date, 'd/M/yyyy')"))
    .withColumn("order_year", F.year("order_date"))
    .withColumn("profit", F.round(F.col("profit"), 2))
)

bad_dates = orders_clean.where("order_date IS NULL OR ship_date IS NULL").count()
assert bad_dates == 0, f"{bad_dates} rows failed date parsing - go look at the source file"

# one row per product for the lookup - product ids repeat across states in
# the master, so joining the full table would fan out the orders
product_lookup = (
    enriched_products
    .select("product_id", "category", "sub_category")
    .dropDuplicates(["product_id"])
)

enriched_orders = (
    orders_clean
    .join(
        enriched_customers.select("customer_id", "customer_name", "country"),
        "customer_id",
        "left",
    )
    .join(product_lookup, "product_id", "left")
    # same idea for the gaps: ~200 rows reference products missing from the
    # master, and a few customers have no name in the source sheet at all -
    # keep the revenue, mark the gaps instead of dropping them
    .withColumn("category", F.coalesce(F.col("category"), F.lit("Unknown")))
    .withColumn("sub_category", F.coalesce(F.col("sub_category"), F.lit("Unknown")))
    .withColumn("customer_name", F.coalesce(F.col("customer_name"), F.lit("Unknown")))
)

enriched_orders.write.mode("overwrite").saveAsTable(f"{SCHEMA}.enriched_orders")
print(f"enriched_orders: {enriched_orders.count()} rows")
print(f"rows with no product master entry: {enriched_orders.where(F.col('category') == 'Unknown').count()}")
print(f"rows with no customer name in the source (name = Unknown): {enriched_orders.where(F.col('customer_name') == 'Unknown').count()}")

