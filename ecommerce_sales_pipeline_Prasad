2. Enriched customers and products
Cleaning pass on the two dimensions. The customer names are the messy part (jammed-in digits, stray punctuation, doubled spaces); the products mostly need a trim and a real type on the price.

def clean_name(col):
    """strip anything that isn't a letter/space/hyphen/apostrophe and squeeze
    the whitespace. the source names have junk jammed into them ('Gary567
    Hansen', 'Ad.       ..am Hart') - we can't recover what got corrupted, but
    at least the formatting comes out consistent."""
    stripped = F.regexp_replace(col, "[^A-Za-z'\\- ]", "")
    return F.trim(F.regexp_replace(stripped, "\\s+", " "))


enriched_customers = raw_customers

# trim the simple columns first, then the name-specific cleanup
for c in ["email", "phone", "address", "segment", "country", "city", "state", "postal_code", "region"]:
    enriched_customers = enriched_customers.withColumn(c, F.trim(F.col(c)))

enriched_customers = (
    enriched_customers
    .withColumn("customer_name", clean_name(F.col("customer_name")))
    .withColumn("email", F.lower(F.col("email")))
    # emails all look fine in the current file - the flag is here so a bad
    # export surfaces as a countable number instead of a surprise downstream
    .withColumn("email_valid", F.col("email").rlike("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"))
    # defensive: no dupes in the current file, but a re-export might have them
    .dropDuplicates(["customer_id"])
)

enriched_customers.write.mode("overwrite").saveAsTable(f"{SCHEMA}.enriched_customers")
print(f"enriched_customers: {enriched_customers.count()} rows")
print(f"customers with no name in the source: {enriched_customers.where(F.col('customer_name').isNull()).count()}")

enriched_customers: 793 rows
customers with no name in the source: 8

# the csv has a nasty quirk: a few dozen product names contain inch marks (")
# inside unquoted fields - the reader treats those as quote characters and
# the fields shift over. most of those rows drift by exactly one (the state
# lands in the price column, the tail of the name in the state column), but
# a handful have two stray commas and drift further. the real price is
# unrecoverable either way, so: fold everything that drifted out of the
# product name back into it, keep the state only when the price column
# actually holds a state name, null the price and flag the row.
is_damaged = ~F.col("price").rlike("^-?\\d+(\\.\\d+)?$")

# real state names, taken from the rows that parsed cleanly - this is how
# we tell a genuine state apart from another name fragment sitting in the
# price column of a double-shifted row
real_states = [
    r["state"]
    for r in raw_products.where(~is_damaged).select("state").distinct().collect()
]
price_is_state = F.col("price").isin(real_states)


def _squeeze(col):
    return F.trim(F.regexp_replace(F.regexp_replace(col, '"', ""), "\\s+", " "))


enriched_products = (
    raw_products
    .withColumn("damaged_row", is_damaged)
    # on a damaged row the state column always holds a piece of the name,
    # and the price column holds either the real state or yet another
    # piece of the name - fold it all back in except when it's a state
    .withColumn("product_name",
        F.when(
            is_damaged,
            _squeeze(
                F.concat_ws(
                    " ",
                    F.col("product_name"),
                    F.col("state"),
                    F.when(price_is_state, F.lit(None)).otherwise(F.col("price")),
                )
            ),
        ).otherwise(_squeeze(F.col("product_name"))),
    )
    .withColumn("state",
        F.when(is_damaged, F.when(price_is_state, F.col("price"))).otherwise(
            F.trim(F.col("state"))
        ),
    )
    .withColumn("price",
        F.when(is_damaged, F.lit(None)).otherwise(F.col("price")).cast("double"),
    )
    .withColumn("category", F.trim(F.col("category")))
    .withColumn("sub_category", F.trim(F.col("sub_category")))
    .dropDuplicates()
)

# note: some product ids appear once per state with a state-specific price, so
# this table keeps every row. category/sub-category never disagree for the
# same id (checked while exploring), which is what makes the lookup in the
# next section safe.
enriched_products.write.mode("overwrite").saveAsTable(f"{SCHEMA}.enriched_products")
print(f"enriched_products: {enriched_products.count()} rows")
print(f"rows repaired after csv mis-parse (price lost): {enriched_products.where(F.col('damaged_row')).count()}")
print(f"repaired rows that also lost their state: {enriched_products.where(F.col('damaged_row') & F.col('state').isNull()).count()}")

